{
  "info": {
    "_postman_id": "50d5d3ad-a6d0-4b25-a57d-c114019ace96",
    "name": "Business Application Integration Service",
    "description": "Local evaluation flows for shipments, electronic invoices, integration jobs, and the simulated SAP Business One boundary.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "apikey",
    "apikey": [
      {
        "key": "key",
        "value": "X-Integration-Key",
        "type": "string"
      },
      {
        "key": "value",
        "value": "{{apiKey}}",
        "type": "string"
      },
      {
        "key": "in",
        "value": "header",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "shipmentIdempotencyKey",
      "value": "shipment-demo-001"
    },
    {
      "key": "invoiceIdempotencyKey",
      "value": "invoice-demo-001"
    }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/health"
      }
    },
    {
      "name": "Submit logistics shipment",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Accepted or idempotent replay', () => pm.expect([200, 202]).to.include(pm.response.code));",
              "const response = pm.response.json();",
              "if (response.id) pm.environment.set('jobId', response.id);"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Idempotency-Key",
            "value": "{{shipmentIdempotencyKey}}"
          },
          {
            "key": "X-Correlation-ID",
            "value": "postman-shipment-demo"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"sourceSystem\": \"warehouse\",\n  \"shipmentId\": \"SHP-1001\",\n  \"orderReference\": \"SO-9001\",\n  \"carrierCode\": \"DHL\",\n  \"trackingNumber\": \"TRACK-1001\",\n  \"status\": \"Dispatched\",\n  \"occurredAtUtc\": \"2026-07-27T09:00:00Z\",\n  \"destinationCountry\": \"ES\"\n}"
        },
        "url": "{{baseUrl}}/api/v1/logistics/shipments"
      }
    },
    {
      "name": "Submit electronic invoice",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Accepted or idempotent replay', () => pm.expect([200, 202]).to.include(pm.response.code));",
              "const response = pm.response.json();",
              "if (response.id) pm.environment.set('jobId', response.id);"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Idempotency-Key",
            "value": "{{invoiceIdempotencyKey}}"
          },
          {
            "key": "X-Correlation-ID",
            "value": "postman-invoice-demo"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"sourceSystem\": \"finance\",\n  \"invoiceNumber\": \"INV-2026-001\",\n  \"customerCode\": \"C-100\",\n  \"currency\": \"EUR\",\n  \"issuedOn\": \"2026-07-27\",\n  \"totalAmount\": 121.00,\n  \"lines\": [\n    {\n      \"itemCode\": \"WATER-TREATMENT-01\",\n      \"quantity\": 1,\n      \"unitPrice\": 100,\n      \"taxRate\": 21\n    }\n  ]\n}"
        },
        "url": "{{baseUrl}}/api/v1/e-invoices"
      }
    },
    {
      "name": "Get integration job",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/v1/jobs/{{jobId}}"
      }
    },
    {
      "name": "Retry failed integration job",
      "request": {
        "method": "POST",
        "header": [],
        "url": "{{baseUrl}}/api/v1/jobs/{{jobId}}/retry"
      }
    },
    {
      "name": "Get updated SAP sales orders",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/sap-business-one/sales-orders?updatedSince=2026-07-01T00:00:00Z",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "sap-business-one",
            "sales-orders"
          ],
          "query": [
            {
              "key": "updatedSince",
              "value": "2026-07-01T00:00:00Z"
            }
          ]
        }
      }
    }
  ]
}
